# .env.example — copy to .env and fill values. NEVER commit the real .env.
# Secrets come ONLY from environment variables (spec 26.3).

# ---- application
PAPER_ONLY=true
LOG_LEVEL=INFO
LOG_DIR=logs

# ---- database
# development / CI:
DATABASE_URL=sqlite:///gold_hybrid.db
# production (recommended):
# DATABASE_URL=postgresql+psycopg2://goldengine:CHANGE_ME@localhost:5432/gold_hybrid

# ---- market data
MARKET_DATA_PROVIDER=mt5
SOURCE_SYMBOL=XAUUSD
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# ---- telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# numeric ids only — get them from @userinfobot
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=

# ---- loop
POLL_SECONDS=5

# ---- web api (frontend spec §18/§22) — REQUIRED in production
# If WEB_AUTH_USERS is unset, development defaults apply (admin/admin123 OWNER,
# viewer/viewer123 VIEWER) and the UI shows a permanent warning.
# WEB_AUTH_USERS=[{"username":"owner1","password":"CHANGE-ME","role":"OWNER"},{"username":"analyst","password":"CHANGE-ME","role":"VIEWER"}]
WEB_SESSION_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8000
WEB_CORS_ORIGINS=http://localhost:3000
